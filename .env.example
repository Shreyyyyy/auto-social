GEMINI_API_KEY=your-gemini-key   # voices (Gemini TTS) + music (Lyria 3)
# Optional overrides
# CLAUDE_MODEL=opus
# TARGET_SECONDS=30
# TTS_MODEL=gemini-2.5-flash-preview-tts
# MUSIC_MODEL=lyria-3-clip-preview  (or drop your own music.mp3 in this folder)
# Buffer: publish.buffer.com -> Settings -> API -> create key
BUFFER_TOKEN=
# run `uv run reel.py channels` to find it
BUFFER_CHANNEL_ID=
# addToQueue (your Buffer time slots) or shareNow
BUFFER_MODE=addToQueue

# Coverr stock video (coverr.co)
COVERR_KEY=

# Optional Cloudinary (cloudinary.com free account) - fixes Buffer "Video could not be read from its URL"
# CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
