# Optional, paid: GEMINI_API_KEY only for Gemini TTS / Lyria music / Gemini research (all off by default)
# GEMINI_API_KEY=
# Optional overrides
# CLAUDE_MODEL=opus
# TARGET_SECONDS=30
# TTS_MODEL=gemini-2.5-flash-preview-tts
# MUSIC_MODEL=lyria-3-clip-preview  (or drop your own music.mp3 in this folder)
# Buffer: publish.buffer.com -> Settings -> API -> create key
BUFFER_TOKEN=
# Reels go to every connected Buffer channel; to limit them list ids here (`./start.sh channels` prints them)
BUFFER_CHANNEL_IDS=
# addToQueue (your Buffer time slots) or shareNow
BUFFER_MODE=addToQueue

# Coverr stock video (coverr.co)
COVERR_KEY=

# Optional Cloudinary (cloudinary.com free account) - fixes Buffer "Video could not be read from its URL"
# CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>

# Pexels free stock video (pexels.com/api) - second footage source
PEXELS_KEY=
# 0 = never send the first comment (Buffer free plan can't), 1 = try it
BUFFER_FIRST_COMMENT=1
# Pixabay free videos (pixabay.com/api/docs) - optional extra footage source
PIXABAY_KEY=

# YouTube Data API (competitor research). API key for public data; OAuth client only for your own channel.
YOUTUBE_API_KEY=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=

# ---- YouTube Shorts posted via Buffer ----
# public | unlisted | private
YOUTUBE_PRIVACY=public
# 27 = Education
YOUTUBE_CATEGORY=27

# ---- Voice ----
# takes recorded per reel (each a different voice); the most natural one is kept
VOICE_TAKES=3

# ---- Claude (scripts) ----
# Claude Code subscription inside Docker: run `claude setup-token` on your computer and paste the token here.
# Research, scripts, footage judging and the review all run on it.
CLAUDE_CODE_OAUTH_TOKEN=
# LLM_PROVIDER=gemini

# ---- Studio access ----
# Password for the web studio (browser sign-in box, any username). Set it before opening the studio from your phone.
STUDIO_PASSWORD=
# Vercel studio (./start.sh tunnel): requests that reach this Mac through the Cloudflare tunnel must carry this token.
# `./start.sh tunnel` creates it; set the same value as API_TOKEN in Vercel.
API_TOKEN=
# Web port (3737) and where it listens: 0.0.0.0 = your Wi-Fi network too, 127.0.0.1 = this computer only
# PORT=3737
# WEB_BIND=0.0.0.0
